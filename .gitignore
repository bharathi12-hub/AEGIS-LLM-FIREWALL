# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
build/
.pytest_cache/

# Lint / tooling caches
.ruff_cache/

# Node / dashboard
node_modules/
dist/
.vite/

# Env & secrets (never commit)
.env
*.key

# Benchmark artifacts (regenerated by `make bench`)
benchmark/out/*.png

# Models (safetensors are large; pin via checksums.json, don't commit weights).
# Use `models/*` rather than `models/` so the example manifest can be negated:
# git cannot re-include a file whose parent directory is itself excluded.
models/*
!models/manifest.example.json
*.safetensors
*.bin
