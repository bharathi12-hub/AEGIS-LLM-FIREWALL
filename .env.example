# AEGIS v2 environment. Copy to .env and adjust. Secrets NEVER live in code (R8).

# --- offline / posture ---
AEGIS_OFFLINE=1
AEGIS_DEFAULT_FAIL_MODE=closed

# --- admin / transport (S10) ---
# Required to enable the admin API. Use a long random value in production.
AEGIS_ADMIN_API_KEY=change-me-admin-key
AEGIS_CORS_ORIGINS=http://localhost:5173
# Server pepper for fast API-key HMAC. Required in production for throughput
# (without it, verification falls back to a slow per-request KDF). Offline uses a
# fixed dev pepper automatically.
# AEGIS_KEY_PEPPER=set-a-32-byte-random-pepper-in-production

# --- infra (optional; in-memory fallbacks when unset) ---
AEGIS_REDIS_URL=redis://redis:6379/0
# AEGIS_DATABASE_URL=postgresql+psycopg://aegis:aegis-dev-pw@postgres:5432/aegis
POSTGRES_PASSWORD=aegis-dev-pw

# --- upstream (empty -> offline mock backend) ---
# AEGIS_UPSTREAM_URL=https://api.openai.com
# AEGIS_UPSTREAM_API_KEY=sk-...

# --- limits (S5 / S14) ---
AEGIS_MAX_PROMPT_CHARS=32000
AEGIS_JUDGE_BUDGET_PER_MIN=30
AEGIS_RATE_LIMIT_PER_MIN=120

# --- timing side-channel defense (S9) ---
AEGIS_RESPONSE_FLOOR_MS=8
AEGIS_RESPONSE_JITTER_MS=4

# --- audit at rest (S7) ---
# AEGIS_AUDIT_KEY=set-a-32-byte-random-key-to-encrypt-audit-meta
AEGIS_REDACT_PII=1
AEGIS_LOG_RETENTION_DAYS=30

# --- optional real ML models (pluggable; heuristic fallback otherwise) ---
# AEGIS_HF_MODEL_DIR=/models          # dir of safetensors-only classifier models
# AEGIS_KAD_MODEL_DIR=/models/kad     # local causal LM for behavioral KAD
# AEGIS_JUDGE_MODEL_DIR=/models/judge # local causal LM for the L4 judge

# --- v2.1 surfaces (indirect prompt injection) ---
# Each surface is independently switchable; 0 disables it (returns explicit
# ALLOW with enabled=false, so the audit trail records a skipped layer).
AEGIS_SURFACE_BROWSER=1
AEGIS_SURFACE_DOCUMENTS=1
AEGIS_SURFACE_RAG=1
AEGIS_SURFACE_MEMORY=1
AEGIS_SURFACE_TOOLS=1
AEGIS_SURFACE_AGENT=1
AEGIS_SURFACE_MULTIMODAL=1

# Surface decision thresholds. Stricter than the prompt thresholds on purpose:
# a user's prompt is allowed to be odd, a retrieved document is not.
AEGIS_SURFACE_BLOCK=0.60
AEGIS_SURFACE_QUARANTINE=0.40
AEGIS_SURFACE_DENSITY=0.25

# Surface resource caps (S19).
AEGIS_SURFACE_MAX_SEGMENT_CHARS=8000
AEGIS_SURFACE_MAX_SEGMENTS=400
AEGIS_SURFACE_MAX_ARTIFACT_BYTES=8000000

# --- v2.1 hardening (see docs/HARDENING.md) ---
# Whole-conversation inspection. The v2.0 gateway inspected only the latest
# user turn, so poisoned tool results, replayed assistant turns, and tool
# descriptions reached the model uninspected. Set to 0 to restore v2.0 behaviour.
AEGIS_INSPECT_CONVERSATION=1
# How many of the most recent messages to inspect per request (DoS bound, on
# top of the schema's 200-message cap).
AEGIS_CONVERSATION_MAX_MESSAGES=40
