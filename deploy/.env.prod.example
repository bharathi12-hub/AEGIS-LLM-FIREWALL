# Production compose secrets — copy to deploy/.env.prod (gitignored). Use long,
# random values from your secret manager; NEVER commit real values (S10).
POSTGRES_PASSWORD=change-me-strong-db-password
AEGIS_ADMIN_API_KEY=change-me-64-char-random-admin-key
AEGIS_AUDIT_KEY=change-me-32-byte-random-key-for-audit-encryption
# Server pepper for fast API-key HMAC (required for throughput; see PRODUCTION.md).
AEGIS_KEY_PEPPER=change-me-32-byte-random-key-pepper
AEGIS_CORS_ORIGINS=https://aegis.example.com
